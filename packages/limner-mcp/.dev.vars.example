# Copy to .dev.vars for local `wrangler dev`. The Deploy to Cloudflare
# button reads these names and prompts for values during deployment.
# Both keys are required for a working stack: the generation tools call
# the providers on the deployer's own accounts.
OPENAI_API_KEY=
RECRAFT_API_KEY=
# D-RA-22 — HMAC secret for the OAuth consent CSRF token. Set any random value
# locally so the /authorize consent flow works under `wrangler dev`; without it,
# non-trusted clients fail closed (503). Production uses a Cloudflare Secret.
OAUTH_CONSENT_SIGNING_KEY=
