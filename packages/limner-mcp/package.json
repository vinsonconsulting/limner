{
  "name": "@limner/mcp",
  "version": "1.0.0",
  "description": "Limner MCP server: Workers Streamable HTTP + stdio + .mcpb bundle.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wasm-init": {
      "types": "./dist/wasm-init.d.ts",
      "import": "./dist/wasm-init.js"
    },
    "./wasm-init-node": {
      "types": "./dist/wasm-init-node.d.ts",
      "import": "./dist/wasm-init-node.js"
    }
  },
  "bin": {
    "limner-mcp": "./dist/stdio.js"
  },
  "files": [
    "dist",
    "src",
    "manifest.json",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p . && chmod +x dist/stdio.js",
    "start:stdio": "node dist/stdio.js",
    "deploy": "wrangler deploy && wrangler d1 migrations apply DB --remote",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "@limner/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@cloudflare/workers-oauth-provider": "^0.7.0",
    "@cloudflare/workers-types": "^4.20250101.0",
    "@modelcontextprotocol/inspector": "^0.21.2",
    "@types/node": "^22.0.0",
    "agents": "^0.14.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.103.0"
  }
}
