# Exclude dev-only paths from the .mcpb bundle. Runtime deps (WASM
# codecs, fonts, better-sqlite3 native bindings) are too large to skip
# but everything below is dead weight at install time.

# Test fixtures + helpers
test/
**/*.test.ts
**/*.test.js
**/*.spec.ts
**/*.test.d.ts

# Source maps (the bundle ships compiled dist/ — maps add ~2x size)
**/*.js.map
**/*.d.ts.map

# Build metadata
**/tsconfig.tsbuildinfo
**/.tsbuildinfo

# Documentation. LICENSE/NOTICE are deliberately NOT excluded — the
# bundle redistributes the work plus Apache/MIT deps, so the license
# texts must ship (Apache-2.0 §4).
**/README.md
**/CHANGELOG.md
**/*.md
docs/

# IDE / editor cruft
.vscode/
.idea/
**/.DS_Store

# Type definitions for dev tools we don't ship at runtime
**/node_modules/@types/

# pnpm metadata
.pnpm-debug.log
pnpm-lock.yaml

# Misc
**/coverage/
**/*.log

# r2 note: the pack root is now a hoisted `pnpm deploy --prod` output
# (scripts/pack-mcpb.mjs) — flat real dirs, full dependency closure, no
# devDependencies, no symlinks. The r1-era de-dup rules for wasm nested
# under the dereferenced @limner/core symlink are obsolete in that layout.

# Architecture / planning docs — they live in docs/ and the resume file,
# not the runtime bundle.
plans/
