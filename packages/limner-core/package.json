{
  "name": "@limner/core",
  "version": "1.0.0",
  "description": "Shared TypeScript foundation for Limner: types, bindings, memory and project stores (D1 + local SQLite).",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "assets",
    "dist",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "build": "tsc -p .",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "miniflare": "^4.0.0",
    "ssim.js": "^3.5.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.3.5",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "better-sqlite3": "^12.0.0",
    "satori": "^0.26.0",
    "ulid": "^3.0.0"
  }
}
